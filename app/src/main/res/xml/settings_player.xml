<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.yenaly.han1meviewer.ui.view.pref.MaterialDialogPreference
        app:iconSpaceReserved="false"
        app:key="switch_player_kernel"
        app:title="@string/switch_player_kernel"
        app:useSimpleSummaryProvider="true" />

    <com.yenaly.yenaly_libs.base.preference.MaterialSwitchPreference
        app:defaultValue="true"
        app:iconSpaceReserved="false"
        app:key="show_bottom_progress"
        app:title="@string/show_bottom_progress" />

    <com.yenaly.han1meviewer.ui.view.pref.MaterialDialogPreference
        app:iconSpaceReserved="false"
        app:key="player_speed"
        app:title="@string/default_playback_speed"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/gesture_settings">

        <Preference
            app:iconSpaceReserved="false"
            app:selectable="false"
            app:summary="@string/gesture_help" />

        <com.yenaly.han1meviewer.ui.view.pref.MaterialDialogPreference
            app:iconSpaceReserved="false"
            app:key="gesture_double_tap_mode"
            app:title="@string/gesture_double_tap_mode"
            app:useSimpleSummaryProvider="true" />

        <com.yenaly.han1meviewer.ui.view.pref.MaterialDialogPreference
            app:iconSpaceReserved="false"
            app:key="gesture_seek_step"
            app:title="@string/gesture_seek_step"
            app:useSimpleSummaryProvider="true" />

        <com.yenaly.han1meviewer.ui.view.pref.MaterialDialogPreference
            app:iconSpaceReserved="false"
            app:key="gesture_long_press_mode"
            app:title="@string/gesture_long_press_mode"
            app:useSimpleSummaryProvider="true" />

        <com.yenaly.han1meviewer.ui.view.pref.MaterialDialogPreference
            app:iconSpaceReserved="false"
            app:key="long_press_speed_times"
            app:title="@string/long_press_speed_multiplier"
            app:useSimpleSummaryProvider="true" />

        <com.yenaly.han1meviewer.ui.view.pref.MaterialDialogPreference
            app:iconSpaceReserved="false"
            app:key="gesture_temporary_speed"
            app:title="@string/gesture_long_press_speed"
            app:useSimpleSummaryProvider="true" />

        <com.yenaly.yenaly_libs.base.preference.MaterialSwitchPreference
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="gesture_seek_enabled"
            app:title="@string/gesture_seek_enabled" />

        <SeekBarPreference
            android:max="9"
            app:defaultValue="5"
            app:dependency="gesture_seek_enabled"
            app:iconSpaceReserved="false"
            app:key="slide_sensitivity"
            app:min="1"
            app:title="@string/slide_sensitivity"
            app:updatesContinuously="true" />

        <com.yenaly.yenaly_libs.base.preference.MaterialSwitchPreference
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="gesture_brightness_enabled"
            app:title="@string/gesture_brightness_enabled" />

        <SeekBarPreference
            android:max="9"
            app:defaultValue="5"
            app:dependency="gesture_brightness_enabled"
            app:iconSpaceReserved="false"
            app:key="gesture_brightness_sensitivity"
            app:min="1"
            app:title="@string/gesture_brightness_sensitivity"
            app:updatesContinuously="true" />

        <com.yenaly.yenaly_libs.base.preference.MaterialSwitchPreference
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="gesture_volume_enabled"
            app:title="@string/gesture_volume_enabled" />

        <SeekBarPreference
            android:max="9"
            app:defaultValue="5"
            app:dependency="gesture_volume_enabled"
            app:iconSpaceReserved="false"
            app:key="gesture_volume_sensitivity"
            app:min="1"
            app:title="@string/gesture_volume_sensitivity"
            app:updatesContinuously="true" />

    </PreferenceCategory>
</PreferenceScreen>
